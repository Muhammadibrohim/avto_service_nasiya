    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
}
