{
  "name": "avto-service-nasiya-backend",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "prisma db push && node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
