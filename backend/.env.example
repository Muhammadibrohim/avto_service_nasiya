# PostgreSQL (Neon) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avto_service_nasiya"
PORT=3000

# Frontend origin(s), comma separated. Used for CORS and the Telegram menu button.
FRONTEND_URL="http://localhost:5173"
TELEGRAM_MENU_URL=https://avto-service-nasiya-two.vercel.app

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""
# How long a Telegram login stays valid, in seconds (default 24h)
TELEGRAM_AUTH_MAX_AGE=86400

# Debt reminders (sent to owner/admins in Telegram once a day)
REMINDERS_ENABLED=true
REMINDER_HOUR=9
TZ_OFFSET_MINUTES=300
# Secret for POST /api/cron/reminders (header x-cron-secret). Use with an external
# cron (e.g. cron-job.org) because the Render free plan sleeps when idle.
CRON_SECRET=""
